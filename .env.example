# Local development against synthetic Firebase emulators (never a live project).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cutter-coach
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cutter-coach.firebaseapp.com
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=velocity-v2

# For an authorized real environment, disable emulators and replace the Firebase
# web configuration above, plus these optional fields. Public keys are bundled;
# restrict them to the intended services and origins in the provider console.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-cutter-coach.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Production configuration is an explicit release action. Omit the database variable or
# set it to (default) to retain/restore the original database. Auth is unchanged.

# Website commerce (leave unset when running only synthetic Swim Resources checks).
# PRINTFUL_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SITE_URL=http://localhost:3000

# Workshare: existing velocityworkshareportal Firebase web app (public settings).
NEXT_PUBLIC_WORKSHARE_FIREBASE_API_KEY=
NEXT_PUBLIC_WORKSHARE_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_WORKSHARE_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_WORKSHARE_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_WORKSHARE_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_WORKSHARE_FIREBASE_APP_ID=
NEXT_PUBLIC_WORKSHARE_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_WORKSHARE_USE_FIREBASE_EMULATORS=false
