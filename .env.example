# Use npm run seed:local to generate ignored local Supabase settings.
# For a hosted release, supply the new project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server collector scripts only; never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Existing public schedule and commerce integrations.
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
PRINTFUL_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SITE_URL=http://127.0.0.1:3001

# Edge Function secrets are configured in Supabase, not the browser.
# VELOCITY_REMINDER_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# OUTBOUND_EMAIL_ENABLED=false
