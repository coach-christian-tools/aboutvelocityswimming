{
  "manifest_version": 3,
  "name": "Swim Resources Swimcloud Sync",
  "version": "1.0.0",
  "description": "Background bridge for syncing Swimcloud athlete best times into Swim Resources.",
  "permissions": [
    "offscreen",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.swimcloud.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.velocity-swimming.com/*",
    "https://aboutvelocityswimming.com/*",
    "https://www.aboutvelocityswimming.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.velocity-swimming.com/*",
        "https://aboutvelocityswimming.com/*",
        "https://www.aboutvelocityswimming.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
